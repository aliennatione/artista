---
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>Attore Monologhista</title>
	</head>
	<body>
		<header>
			<nav>
				<a href={`${base}/`}>Home</a>
				<a href={`${base}/monologhi`}>Monologhi</a>
				<a href={`${base}/libri`}>Libri</a>
				<a href={`${base}/articoli`}>Articoli</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<style>
			header { padding: 1rem; border-bottom: 1px solid #ddd; }
			nav a { margin-right: 1rem; text-decoration: none; color: #333; }
			main { max-width: 900px; margin: 2rem auto; padding: 0 1rem; font-family: system-ui, sans-serif; }
		</style>
	</body>
</html>
